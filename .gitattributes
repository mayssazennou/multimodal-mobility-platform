# Par défaut : détection auto, LF dans le dépôt et dans le dossier de travail
* text=auto eol=lf

# Scripts et fichiers qui doivent absolument rester en LF
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Fichiers Windows qui exigent CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.sln       text eol=crlf